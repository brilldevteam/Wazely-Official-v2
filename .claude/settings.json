{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/typecheck-lint.cjs",
            "async": true,
            "asyncRewake": true,
            "timeout": 180,
            "statusMessage": "Running typecheck + lint in the background…"
          }
        ]
      }
    ]
  }
}
